{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albedo",
  "version": "0.1.0",
  "identifier": "com.infinition.albedo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albedo",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://www.gstatic.com https://cdn.jsdelivr.net data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["glb", "gltf", "fbx", "obj", "stl", "ply", "dae", "3mf", "3ds", "usdz", "wrl", "vrml", "vox", "amf", "pcd", "xyz"],
        "name": "Modele3D",
        "description": "Modèle 3D",
        "role": "Viewer"
      },
      {
        "ext": ["nif", "kf", "kfa"],
        "name": "ModeleNIF",
        "description": "Modèle NetImmerse / Gamebryo",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
