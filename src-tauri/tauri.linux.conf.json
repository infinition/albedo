{
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "python3-gi",
          "gir1.2-webkit2-4.1",
          "xvfb",
          "xauth",
          "libgl1-mesa-dri"
        ],
        "files": {
          "/usr/bin/albedo-thumbnailer": "../platform/linux/albedo-thumbnailer",
          "/usr/lib/albedo-thumbnailer/thumbnailer.py": "../platform/linux/thumbnailer.py",
          "/usr/lib/albedo-thumbnailer/dist": "../dist",
          "/usr/share/mime/packages/albedo.xml": "../platform/linux/albedo.xml"
        }
      },
      "rpm": {
        "depends": [
          "python3-gobject",
          "webkit2gtk4.1",
          "xorg-x11-server-Xvfb",
          "xorg-x11-xauth",
          "mesa-dri-drivers"
        ],
        "files": {
          "/usr/bin/albedo-thumbnailer": "../platform/linux/albedo-thumbnailer",
          "/usr/lib/albedo-thumbnailer/thumbnailer.py": "../platform/linux/thumbnailer.py",
          "/usr/lib/albedo-thumbnailer/dist": "../dist",
          "/usr/share/mime/packages/albedo.xml": "../platform/linux/albedo.xml"
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "glb"
        ],
        "mimeType": "model/gltf-binary",
        "name": "GLB 3D model",
        "role": "Viewer"
      },
      {
