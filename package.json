{
  "name": "albedo",
  "version": "1.5.1",
  "description": "Local 3D asset viewer for Windows, macOS and Linux",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-codecs.mjs && vite",
    "build": "node scripts/platform-metadata.mjs && node scripts/prepare-codecs.mjs && vite build",
    "build:thumbnails": "node scripts/build-thumbnails.mjs",
    "build:all": "npm run build && npm run build:thumbnails",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
