{
  "name": "albedo",
  "version": "1.3.0",
  "description": "Local 3D asset viewer for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:thumbnails": "cargo build --release --manifest-path shell-thumbnails/Cargo.toml",
    "build:all": "npm run build:thumbnails && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
